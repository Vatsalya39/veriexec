# INTENTLOCK environment — all values empty by default; no key needed for offline demo
INTENTLOCK_MODE=offline
INTENTLOCK_LLM_PROVIDER=anthropic
INTENTLOCK_LLM_API_KEY=
INTENTLOCK_LLM_MODEL=
INTENTLOCK_SEED=1337
INTENTLOCK_HMAC_SECRET=dev-only-not-a-secret
INTENTLOCK_AUTH_TTL_SECONDS=600
INTENTLOCK_CHALLENGE_TTL_SECONDS=120
INTENTLOCK_POLICY_VERSION=1.0.0
INTENTLOCK_A_URL=http://localhost:8001
INTENTLOCK_B_URL=http://localhost:8002
INTENTLOCK_C_URL=http://localhost:8003
INTENTLOCK_TZ=Asia/Kolkata
