# INTENTLOCK — environment contract (00_SHARED_CONTEXT.md §13)
# Copy to .env and fill in. Committed with EMPTY secret values by design.
# Every value below is a safe offline default: `make demo` must work with no edits.

# live | cached | offline | production
INTENTLOCK_MODE=offline

# anthropic | openai | none
INTENTLOCK_LLM_PROVIDER=anthropic

# Leave empty. Absent key => silently fall back to offline. Never crash.
INTENTLOCK_LLM_API_KEY=

# Seed for every stochastic path. Same seed => same output.
INTENTLOCK_SEED=1337

# Dev-only default. Startup REFUSES if INTENTLOCK_MODE=production and this is unchanged.
INTENTLOCK_HMAC_SECRET=dev-only-not-a-secret

# Unset => demo-only routes return 404 (not 403). Set to 1 only for rehearsal.
INTENTLOCK_DEMO_ENDPOINTS=

# Authorization / challenge lifetimes (seconds)
INTENTLOCK_AUTH_TTL_SECONDS=600
INTENTLOCK_CHALLENGE_TTL_SECONDS=120

# Policy identity. Bump per contracts/POLICY_VERSION rules.
INTENTLOCK_POLICY_VERSION=1.0.0

# Service discovery
INTENTLOCK_A_URL=http://127.0.0.1:8001
INTENTLOCK_B_URL=http://127.0.0.1:8002
INTENTLOCK_C_URL=http://127.0.0.1:8003

INTENTLOCK_TZ=Asia/Kolkata

# Team B §15.1 — scales ONLY cooldown/breaker clocks. Never token/challenge/freshness expiry.
INTENTLOCK_DEMO_TIME_SCALE=1.0

# Team B state store (sqlite). Created on first use.
INTENTLOCK_DB_PATH=var/intentlock_core.sqlite
