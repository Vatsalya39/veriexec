# INTENTLOCK — Environment Configuration Template
# All keys have safe dev defaults when unset.

# System & Seed
INTENTLOCK_MODE=offline
INTENTLOCK_SEED=1337
INTENTLOCK_TZ=Asia/Kolkata
INTENTLOCK_POLICY_VERSION=1.0.0
INTENTLOCK_CONTRACTS_DIR=

# Security & Secrets
INTENTLOCK_HMAC_SECRET=dev-only-not-a-secret
INTENTLOCK_HMAC_KEY=dev-only-not-a-secret

# Timeouts & Windows
INTENTLOCK_AUTH_TTL_SECONDS=600
INTENTLOCK_CHALLENGE_TTL_SECONDS=120
INTENTLOCK_UPSTREAM_TIMEOUT_S=3.0

# LLM Configuration (Optional: offline mode is fully deterministic)
INTENTLOCK_LLM=0
INTENTLOCK_LLM_PROVIDER=ollama
INTENTLOCK_LLM_MODEL=qwen3:14b
INTENTLOCK_LLM_API_KEY=

# Service Endpoints
INTENTLOCK_A_URL=http://127.0.0.1:8001
INTENTLOCK_SIGNAL_URL=http://127.0.0.1:8001
INTENTLOCK_B_URL=http://127.0.0.1:8002
INTENTLOCK_CORE_URL=http://127.0.0.1:8002
INTENTLOCK_C_URL=http://127.0.0.1:8003
INTENTLOCK_AUDIT_URL=http://127.0.0.1:8003

# Storage Paths
INTENTLOCK_AUDIT_DB=var/audit.db
INTENTLOCK_AUDIT_HEAD=var/audit_head.txt
INTENTLOCK_AUDIT_PORT=8003

# Demo Flags (Set to 1 for stage demo affordances like POST /v1/audit/_tamper)
INTENTLOCK_DEMO_ENDPOINTS=0
INTENTLOCK_DEMO_TIME_SCALE=1.0

# Console Environment Variables (Vite)
VITE_SIGNAL_URL=http://127.0.0.1:8001
VITE_CORE_URL=http://127.0.0.1:8002
VITE_AUDIT_URL=http://127.0.0.1:8003
