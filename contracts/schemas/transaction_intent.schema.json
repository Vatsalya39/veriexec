{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransactionIntent",
  "type": "object",
  "required": ["transaction_id", "requester", "action", "amount", "currency", "beneficiary",
               "destination_account", "purpose", "deadline", "urgency", "secrecy_flags",
               "channel", "raw_transcript_or_text", "timestamp",
               "extraction_confidence", "extraction_mode", "deterministic_intent",
               "extraction_divergence", "injection_flags", "amount_normalization",
               "language_detected", "origin_session_id", "sample_id"],
  "properties": {
    "transaction_id": {"type": "string"},
    "requester": {"type": "string"},
    "action": {"enum": ["TRANSFER", "CREDENTIAL_RESET", "BENEFICIARY_CHANGE", "PAYMENT_LIMIT_CHANGE", "OTHER"]},
    "amount": {"type": ["number", "null"]},
    "currency": {"type": ["string", "null"]},
    "beneficiary": {"type": ["string", "null"]},
    "destination_account": {"type": ["string", "null"]},
    "purpose": {"type": ["string", "null"]},
    "deadline": {"type": ["string", "null"]},
    "urgency": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "secrecy_flags": {"type": "array", "items": {"type": "string"}},
    "channel": {"enum": ["PHONE", "VIDEO", "EMAIL", "CHAT", "COLLAB_PLATFORM"]},
    "raw_transcript_or_text": {"type": "string"},
    "timestamp": {"type": "string"},
    "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 100},
    "extraction_mode": {"enum": ["llm", "deterministic", "hybrid", "failed"]},
    "deterministic_intent": {},
    "extraction_divergence": {"type": "array", "items": {"type": "string"}},
    "injection_flags": {"type": "array", "items": {"type": "string"}},
    "amount_normalization": {},
    "language_detected": {"type": "string"},
    "origin_session_id": {"type": "string"},
    "sample_id": {"type": ["string", "null"]}
  }
}
