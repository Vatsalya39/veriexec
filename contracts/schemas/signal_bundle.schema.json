{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignalBundle",
  "type": "object",
  "required": ["transaction_id", "identity_confidence", "communication_authenticity",
               "deepfake_voice_score", "deepfake_video_score", "stylometry_match_score",
               "social_engineering_score", "social_engineering_indicators", "duress_flag",
               "duress_reason", "channel_timeline", "device_info",
               "detector_reports", "detector_disagreement", "voice_abstain", "video_abstain",
               "replay_similarity", "freshness_token_echoed", "channel_switch_flags",
               "origin_channel_id", "stylometry_features"],
  "properties": {
    "transaction_id": {"type": "string"},
    "identity_confidence": {"type": "number", "minimum": 0, "maximum": 100},
    "communication_authenticity": {"type": "number", "minimum": 0, "maximum": 100},
    "deepfake_voice_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "deepfake_video_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "stylometry_match_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "social_engineering_score": {"type": "number", "minimum": 0, "maximum": 100},
    "social_engineering_indicators": {"type": "array", "items": {"type": "string"}},
    "duress_flag": {"type": "boolean"},
    "duress_reason": {"type": ["string", "null"]},
    "channel_timeline": {"type": "array", "items": {"type": "object"}},
    "device_info": {"type": "object", "required": ["device_id", "known_device", "location"],
                    "properties": {"device_id": {"type": "string"},
                                   "known_device": {"type": "boolean"},
                                   "location": {"type": "string"}}},
    "detector_reports": {"type": "array", "items": {"type": "object"}},
    "detector_disagreement": {"type": "number", "minimum": 0, "maximum": 100},
    "voice_abstain": {"type": "boolean"},
    "video_abstain": {"type": "boolean"},
    "replay_similarity": {},
    "freshness_token_echoed": {"type": ["boolean", "null"]},
    "channel_switch_flags": {"type": "array", "items": {"type": "string"}},
    "origin_channel_id": {"type": "string"},
    "stylometry_features": {},
    "identity_evidence": {"type": "array", "items": {"type": "object"}},
    "authenticity_evidence": {"type": "array", "items": {"type": "object"}}
  }
}
